{
	"name": "fermentario",
	"private": true,
	"version": "0.28.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node scripts/start.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "pnpm run test:web",
		"test:web": "node scripts/web-smoke.mjs",
		"test:onboarding": "node scripts/onboarding-smoke.mjs",
		"db:migrate:all": "node --experimental-strip-types scripts/migrate-all.ts",
		"test:web:update": "pnpm run build && node scripts/make-fixture.mjs && node scripts/web-smoke.mjs --update",
		"fixture": "node scripts/make-fixture.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/dom-speech-recognition": "^0.0.12",
		"@types/markdown-it": "^14.2.0",
		"@types/ws": "^8.18.2",
		"daisyui": "^5.7.42",
		"playwright-core": "^1.65.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@lucide/svelte": "^1.47.0",
		"better-sqlite3": "^13.0.3",
		"epubjs": "^0.3.93",
		"markdown-it": "^15.0.3",
		"markdown-it-task-lists": "^2.1.1",
		"nostr-tools": "^2.26.0",
		"ws": "^8.23.0"
	}
}
